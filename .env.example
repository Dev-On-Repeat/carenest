# ==============================================================================
# CareNest AI — Environment Variables Template
# Copy to .env in backend/ or root
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="CareNest AI"
API_V1_STR="/api"

# Security & JWT Tokens
SECRET_KEY=carenest-production-jwt-secret-key-2026-high-security
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///./carenest.db

# Or Cloud Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Optional External AI LLM API Keys (Gemini / OpenAI)
# If not provided, CareNest uses its built-in rule-based medicine database assistant
GEMINI_API_KEY=
OPENAI_API_KEY=

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost:8000","*"]

